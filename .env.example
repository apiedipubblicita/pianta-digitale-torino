# ── Mappedin ──────────────────────────────────────────────────────────────────
# API Secret del progetto Mappedin (dashboard Mappedin → API Keys)
VITE_MAPPEDIN_SECRET=mis_...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (dashboard Supabase → Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon public key (dashboard Supabase → Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Evento ────────────────────────────────────────────────────────────────────
# Nome slug della città, tutto minuscolo, senza spazi (es: roma, napoli, torino)
VITE_CITY=roma
